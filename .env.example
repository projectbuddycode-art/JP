# Optional email (server-only)
RESEND_API_KEY=
EMAIL_FROM=

# n8n — required for scheduled automations (server-only). Lead ingest does not wait on n8n.
N8N_BASE_URL=
N8N_API_KEY=
N8N_INGEST_WEBHOOK_URL=
# Same value as CRON_SECRET, stored on the n8n host as CRM_CRON_SECRET.

# Webhook secrets (server-only)
GOOGLE_ADS_WEBHOOK_KEY=
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
