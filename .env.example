LINKEDIN_WEBHOOK_SECRET=
TIKTOK_APP_SECRET=
TIKTOK_WEBHOOK_TOKEN=
INGEST_WEBHOOK_SECRET=
RESEND_WEBHOOK_SECRET=

# Error monitoring (optional)
